    {
      "dimensionName": "正性情绪",
      "dimensionCode": "positive_affect",
      "num": 1,
      "evaluateExpression": "(hx_t_1 + hx_t_3 + hx_t_5 + hx_t_9 + hx_t_11 + hx_t_13 + hx_t_14 + hx_t_16 + hx_t_18 + hx_t_19)",
      "standardScoreFormula": "",
      "results": [
        {
          "evaluateExpression": "hx_wd_y_1 <= 20",
          "conclusionAnalysis": "正性情绪水平较低",
          "suggestion": "您的正性情绪得分较低，可能处于情绪低落状态，建议关注自身情绪健康。",
          "assessmentWarning": "low"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 20 && hx_wd_y_1 <= 30",
          "conclusionAnalysis": "正性情绪水平中等",
          "suggestion": "您的正性情绪处于中等水平，总体情绪状态尚可。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 30 && hx_wd_y_1 <= 40",
          "conclusionAnalysis": "正性情绪水平较高",
          "suggestion": "您的正性情绪得分较高，情绪状态积极良好。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 40",
          "conclusionAnalysis": "正性情绪水平很高",
          "suggestion": "您的正性情绪得分非常高，情绪状态非常积极。",
          "assessmentWarning": "none"
        }
      ]
    },
    {
