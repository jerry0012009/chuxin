  "dimensions": [
    {
      "dimensionName": "外向性",
      "dimensionCode": "extraversion",
      "num": 1,
      "evaluateExpression": "(hx_t_1 + hx_t_6) / 2",
      "standardScoreFormula": "",
      "results": [
        {
          "evaluateExpression": "hx_wd_y_1 <= 2.5",
          "conclusionAnalysis": "外向性较低",
          "suggestion": "您倾向于内向安静，更喜欢独处或小范围社交。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 2.5 && hx_wd_y_1 <= 4.5",
          "conclusionAnalysis": "外向性中等",
          "suggestion": "您的社交倾向处于正常范围，能灵活适应不同社交场景。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 4.5 && hx_wd_y_1 <= 5.5",
          "conclusionAnalysis": "外向性偏高",
          "suggestion": "您倾向外向活跃，喜欢社交和刺激。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 5.5",
          "conclusionAnalysis": "外向性很高",
          "suggestion": "您非常外向热情，社交能量充沛。",
          "assessmentWarning": "none"
        }
