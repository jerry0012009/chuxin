      "standardScoreFormula": "",
      "results": [
        {
          "evaluateExpression": "hx_wd_y_1 <= 40",
          "conclusionAnalysis": "执行功能良好",
          "suggestion": "您的WebEXEC总分较低，表明您在日常生活中执行功能表现良好，组织、计划和多任务处理能力较强。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 40 && hx_wd_y_1 <= 55",
          "conclusionAnalysis": "执行功能轻度困难",
          "suggestion": "您的WebEXEC总分处于中等范围，表明您在日常执行功能方面存在一些轻度困难，但不影响正常生活。",
          "assessmentWarning": "none"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 55 && hx_wd_y_1 <= 75",
          "conclusionAnalysis": "执行功能中度困难",
          "suggestion": "您的WebEXEC总分偏高，表明您在组织、计划、任务切换等执行功能方面存在中度困难，建议关注并采取相应策略。",
          "assessmentWarning": "low"
        },
        {
          "evaluateExpression": "hx_wd_y_1 > 75",
          "conclusionAnalysis": "执行功能显著困难",
          "suggestion": "您的WebEXEC总分明显偏高，表明您在日常执行功能方面存在显著困难，建议寻求专业评估和帮助。",
          "assessmentWarning": "middle"
        }
      ]
    }
